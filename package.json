{
  "name": "zone-switch",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:maintenance": "wrangler dev --config wrangler.maintenance.jsonc --ip 127.0.0.1 --port 8790",
    "dev:billing": "wrangler dev --config wrangler.billing.jsonc --ip 127.0.0.1 --port 8791",
    "check": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build:ui": "vite build",
    "build:ci": "npm run check && npm run build:ui",
    "deploy:ci": "wrangler deploy --config wrangler.jsonc",
    "deploy:maintenance": "wrangler deploy --config wrangler.maintenance.jsonc",
    "deploy:billing": "wrangler deploy --config wrangler.billing.jsonc",
    "dry-run:all": "node scripts/deploy.mjs --dry-run",
    "deploy:all": "node scripts/deploy.mjs",
    "build": "vite build && wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "vite build && wrangler deploy",
    "password": "node scripts/password.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.2.0",
    "@radix-ui/react-form": "^0.3.0",
    "@radix-ui/react-toast": "^1.3.0",
    "@radix-ui/react-toggle-group": "^1.2.0",
    "@radix-ui/themes": "^3.3.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
